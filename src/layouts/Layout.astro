---
import "../styles/global.css";
import { links } from "../lib/profile";

interface Props {
  title: string;
  description?: string;
  noIndex?: boolean;
  pageType?: "website" | "profile" | "article";
}

const {
  title,
  description = "Purushotham Sirasapalli: software engineer for systems, robotics, and performance-critical code. 6× faster caching in Rust, robot swarms on Raspberry Pi, RL control at 10 m/s.",
  noIndex = false,
  pageType = "website",
} = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => path === href || path.startsWith(href + "/");
const og = new URL("/og-image.jpg", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fcfcfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0e11" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={pageType} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {noIndex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={Astro.url.href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {pageType === "profile" && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "Person",
          name: "Purushotham Sirasapalli",
          url: "https://purusirasapalli.com",
          email: links.email,
          jobTitle: "Software Engineer",
          alumniOf: { "@type": "CollegeOrUniversity", name: "University at Buffalo" },
          sameAs: [links.github, links.gitlab, links.linkedin],
          knowsAbout: ["C++", "Rust", "Performance engineering", "Systems programming", "Embedded systems", "ROS 2", "Reinforcement learning", "Gaussian processes"],
        })}
      />
    )}
  </head>
  <body>
    <a href="#content" class="skip">Skip to content</a>
    <div class="page">
      <nav class="site" aria-label="Primary">
        <a href="/" class="home" aria-current={path === "/" ? "page" : undefined}><span class="full">purushotham </span>sirasapalli</a>
        <a href="/projects" aria-current={isActive("/projects") ? "page" : undefined}>projects</a>
        <a href={links.resume}>resume</a>
        <a href="/contact" aria-current={isActive("/contact") ? "page" : undefined}>contact</a>
      </nav>
      <main id="content">
        <slot />
      </main>
      <footer class="site">
        <span>© {new Date().getFullYear()} Purushotham Sirasapalli</span>
        <span>
          <a href={links.github}>github</a> · <a href={links.gitlab}>gitlab</a> ·
          <a href={links.linkedin}>linkedin</a> ·
          <a href="https://github.com/purushotham91/personal-website">source</a>
        </span>
      </footer>
    </div>
  </body>
</html>
