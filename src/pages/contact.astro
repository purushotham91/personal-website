---
import Layout from "../layouts/Layout.astro";
import { links } from "../lib/profile";
---

<Layout
  title="Contact · Purushotham Sirasapalli"
  description="Email, LinkedIn, GitHub, and GitLab for Purushotham Sirasapalli. Open to full-time systems, embedded, performance, robotics, and ML infra roles."
>
  <h1>Contact</h1>
  <p class="lede">
    Email is the fastest way to reach me. If you're a recruiter or hiring
    manager, putting the role title in the subject line helps.
  </p>

  <ul class="rows">
    <li><span>Email</span><a href={`mailto:${links.email}`}>{links.email}</a></li>
    <li><span>LinkedIn</span><a href={links.linkedin}>linkedin.com/in/puru-sirasapalli</a></li>
    <li><span>GitHub</span><a href={links.github}>github.com/purushotham91</a></li>
    <li><span>GitLab</span><a href={links.gitlab}>gitlab.com/puru_s</a></li>
    <li><span>Resume</span><a href={links.resume}>PDF, one page</a></li>
  </ul>

  <h2>What I'm looking for</h2>
  <p>
    Full-time new-grad engineering roles in systems, embedded, performance,
    robotics/autonomy, or ML infrastructure. I can start now and I'm open to
    relocating or working remotely. Preferred: New York, Boston, Buffalo, or
    remote (US).
  </p>
</Layout>
