---
import Layout from "../layouts/Layout.astro";
import Row from "../components/Row.astro";
import { links } from "../lib/profile";
---

<Layout
  title="Contact · Purushotham Sirasapalli"
  description="Email, LinkedIn, GitHub, and GitLab for Purushotham Sirasapalli. Open to full-time systems, embedded, performance, robotics, and ML infra roles."
>
  <section class="hero">
    <h1>Contact</h1>
    <p class="lede">Email is the fastest way to reach me.</p>
    <div class="actions">
      <a class="btn primary" href={`mailto:${links.email}`}>Email me</a>
      <a class="btn" href={links.resume}>Resume</a>
    </div>
  </section>

  <section>
    <h2>Links</h2>
    <ul class="rows">
      <Row href={`mailto:${links.email}`} title="Email" sub={links.email} />
      <Row href={links.linkedin} title="LinkedIn" sub="linkedin.com/in/puru-sirasapalli" />
      <Row href={links.github} title="GitHub" sub="github.com/purushotham91" />
      <Row href={links.gitlab} title="GitLab" sub="gitlab.com/puru_s" />
    </ul>
  </section>

  <section>
    <h2>Open to</h2>
    <ul class="rows">
      <Row title="Roles" sub="Full-time: systems, embedded, performance, robotics, ML infrastructure" />
      <Row title="Location" sub="New York, Boston, Buffalo, or remote. Open to relocation." />
      <Row title="Start" sub="Available now" />
    </ul>
  </section>
</Layout>
