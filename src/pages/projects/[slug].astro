---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { statusLabel, projectBlurb } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).sort(
    (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99),
  );
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: i > 0 ? projects[i - 1] : null,
      next: i < projects.length - 1 ? projects[i + 1] : null,
    },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
  prev: CollectionEntry<"projects"> | null;
  next: CollectionEntry<"projects"> | null;
}

const { project, prev, next } = Astro.props;
const { Content } = await project.render();
const description =
  projectBlurb[project.slug] ??
  `${project.data.title}: ${project.data.role}, ${statusLabel[project.data.status]}.`;
---

<Layout title={`${project.data.title} · Purushotham Sirasapalli`} description={description} pageType="article">
  <p class="crumbs">
    <a href="/projects">← projects</a>
    <span class="tag">{statusLabel[project.data.status]}</span>
    <span class="tag">{project.data.role}</span>
  </p>
  <article>
    <Content />
  </article>
  {project.data.stack && <ul class="tags">{project.data.stack.map((t) => <li>{t}</li>)}</ul>}

  <nav class="pager" aria-label="Adjacent projects">
    {prev ? <a href={`/projects/${prev.slug}`}>← {prev.data.title}</a> : <span />}
    {next ? <a href={`/projects/${next.slug}`}>{next.data.title} →</a> : <span />}
  </nav>
</Layout>
