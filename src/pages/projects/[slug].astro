---
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Stats from "../../components/Stats.astro";
import { getProjects, statusLabel } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: projects[i - 1] ?? null,
      next: projects[i + 1] ?? null,
    },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
  prev: CollectionEntry<"projects"> | null;
  next: CollectionEntry<"projects"> | null;
}

const { project, prev, next } = Astro.props;
const { title, summary, role, status, stack, results, links } = project.data;
const { Content } = await project.render();
---

<Layout title={`${title} · Purushotham Sirasapalli`} description={summary} pageType="article">
  <section class="hero">
    <a class="back" href="/projects">← Projects</a>
    <h1>{title}</h1>
    <p class="lede">{summary}</p>
    <p class="meta">{role} · {statusLabel[status]}</p>
    {links && (
      <div class="actions">
        {links.map((l) => <a class="btn" href={l.href}>{l.label} ↗</a>)}
      </div>
    )}
  </section>

  {results && <Stats items={results} />}

  <article class="prose">
    <Content />
    <h2>Stack</h2>
    <p class="muted">{stack.join(" · ")}</p>
  </article>

  <nav class="pager" aria-label="More projects">
    {prev ? <a href={`/projects/${prev.slug}`}><span>Previous</span>{prev.data.title}</a> : <span />}
    {next ? <a class="next" href={`/projects/${next.slug}`}><span>Next</span>{next.data.title}</a> : <span />}
  </nav>
</Layout>
