---
import Layout from "../../layouts/Layout.astro";
import Row from "../../components/Row.astro";
import { getProjects } from "../../lib/projects";

const projects = await getProjects();
---

<Layout
  title="Projects · Purushotham Sirasapalli"
  description="Systems and robotics projects: SKiM's Rust caching layer (6× faster, 80% less memory), a decentralized robot swarm, RL aerial tracking, Coriolis-Lite, SKiMet."
>
  <section class="hero">
    <h1>Projects</h1>
    <p class="lede">Systems, performance, and robotics work from the SCoRe and ADAMS labs.</p>
  </section>

  <ul class="rows">
    {projects.map((p) => (
      <Row href={`/projects/${p.slug}`} title={p.data.title} sub={p.data.summary} meta={p.data.tech} />
    ))}
  </ul>
</Layout>
