---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { projectBlurb, statusLabel } from "../../lib/projects";

const projects = (await getCollection("projects")).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99),
);
---

<Layout
  title="Projects · Purushotham Sirasapalli"
  description="Performance and systems work: SKiM's Rust caching layer (6× faster, 80% less RAM), a decentralized robot swarm, RL aerial tracking, Coriolis-Lite, SKiMet."
>
  <h1>Projects</h1>
  <p class="lede">
    Each write-up covers the constraint, what I built, and how I measured it.
  </p>

  <ul class="projects">
    {projects.map((p) => (
      <li>
        <a class="card" href={`/projects/${p.slug}`}>
          <h3>{p.data.title}</h3>
          <p class="meta">{p.data.role} · {statusLabel[p.data.status]}</p>
          <p>{projectBlurb[p.slug] ?? ""}</p>
          {p.data.stack && <ul class="tags">{p.data.stack.map((t) => <li>{t}</li>)}</ul>}
        </a>
      </li>
    ))}
  </ul>
</Layout>
