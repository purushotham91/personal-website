---
import Layout from "../layouts/Layout.astro";
import Row from "../components/Row.astro";
import Stats from "../components/Stats.astro";
import { getProjects } from "../lib/projects";
import { links, stats, experience, education, skills } from "../lib/profile";

const featured = (await getProjects()).slice(0, 4);
---

<Layout title="Purushotham Sirasapalli · Software Engineer" pageType="profile">
  <section class="hero">
    <h1>Purushotham Sirasapalli</h1>
    <p class="lede">
      Software engineer. I make code fast on small hardware, from Rust and C++
      systems to robots and on-device ML.
    </p>
    <p class="meta"><span class="dot"></span>Available now · Buffalo, NY · Open to relocation</p>
    <div class="actions">
      <a class="btn primary" href={`mailto:${links.email}`}>Email me</a>
      <a class="btn" href={links.resume}>Resume</a>
      <a class="btn" href={links.linkedin}>LinkedIn</a>
    </div>
  </section>

  <Stats items={stats} />

  <section>
    <h2>Selected work</h2>
    <ul class="rows">
      {featured.map((p) => (
        <Row href={`/projects/${p.slug}`} title={p.data.title} sub={p.data.summary} meta={p.data.tech} />
      ))}
    </ul>
    <a class="more" href="/projects">All projects →</a>
  </section>

  <section>
    <h2>Experience</h2>
    <ul class="rows">{experience.map((r) => <Row {...r} />)}</ul>
  </section>

  <section>
    <h2>Education</h2>
    <ul class="rows">{education.map((r) => <Row {...r} />)}</ul>
  </section>

  <section>
    <h2>Skills</h2>
    <ul class="rows">{skills.map((r) => <Row {...r} />)}</ul>
  </section>
</Layout>
