---
import Layout from "../layouts/Layout.astro";
import { links, impact, work, experience, skills } from "../lib/profile";
---

<Layout title="Purushotham Sirasapalli · Software Engineer" pageType="profile">
  <span class="avail">available now</span>
  <h1>Purushotham Sirasapalli</h1>
  <p class="lede">
    Software engineer. I make code fast on small hardware.
    <span>Systems · performance · robotics. CS @ University at Buffalo '26.</span>
  </p>

  <div class="ctas">
    <a class="btn primary" href={`mailto:${links.email}`}>Email me</a>
    <a class="btn" href={links.resume}>Resume</a>
    <a class="btn" href={links.linkedin}>LinkedIn</a>
  </div>

  <ul class="impact" aria-label="Results">
    {impact.map((s) => <li><b>{s.value}</b><span>{s.label}</span></li>)}
  </ul>

  <h2>Work</h2>
  <ul class="list">
    {work.map((w) => (
      <li><a href={`/projects/${w.slug}`}>{w.title}</a><span>{w.line}</span></li>
    ))}
  </ul>
  <p><a href="/projects">All projects →</a></p>

  <h2>Experience</h2>
  <ul class="list">
    {experience.map((j) => (
      <li><strong>{j.title}</strong><span>{j.org}</span><time>{j.dates}</time></li>
    ))}
  </ul>

  <h2>Skills</h2>
  <ul class="tags">{skills.map((s) => <li>{s}</li>)}</ul>
</Layout>
